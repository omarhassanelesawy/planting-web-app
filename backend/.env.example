# ═══════════════════════════════════════════════════════
# GreenThumb Reminder — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────
PORT=5001

# ── Database ─────────────────────────────────────────────
# Development: leave TURSO_URL unset — uses a local SQLite file.
DB_PATH=./database.sqlite

# Production (Turso hosted SQLite — free tier at turso.tech):
# 1. Install CLI:  brew install tursodatabase/tap/turso
# 2. Sign up:      turso auth signup
# 3. Create DB:    turso db create greenthumb
# 4. Get URL:      turso db show greenthumb --url
# 5. Get token:    turso db tokens create greenthumb
TURSO_URL=
TURSO_AUTH_TOKEN=

# ── CORS ─────────────────────────────────────────────────
# Your Vercel frontend URL in production.
# Leave blank for local development (localhost:3000 is always allowed).
# Example: https://greenthumb.vercel.app
FRONTEND_URL=

# ── Email (Nodemailer / SMTP) ─────────────────────────────
# ---- Gmail App Password (recommended) ----
# Setup: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Create an app for "Mail" and copy the 16-character password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# ---- Outlook / Hotmail (alternative) ----
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your@outlook.com
# SMTP_PASS=your-outlook-password

# ---- SendGrid (alternative — 100 free emails/day) ----
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key_here

# ── Report Recipient ──────────────────────────────────────
# The email address that will receive the daily watering report.
# Can be the same as SMTP_USER or a different address.
RECIPIENT_EMAIL=your-email@gmail.com
