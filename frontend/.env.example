# ═══════════════════════════════════════════════════════
# GreenThumb Reminder — Frontend Environment Variables
# Set these in Vercel dashboard under Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────────
# Development: leave empty — Vite dev server proxies /api → localhost:5001
# Production: set to your Render backend URL (no trailing slash)
# Example: https://greenthumb-api.onrender.com
VITE_API_URL=
